# Frontend (set these in Vercel > Project > Settings > Environment Variables too)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
# Teams type only a username; it is turned into username@VITE_LOGIN_DOMAIN for Supabase Auth.
# Must match LOGIN_DOMAIN used by scripts/import-teams.mjs.
VITE_LOGIN_DOMAIN=teams.obscura.local

# Organiser-only, for scripts/import-teams.mjs. NEVER put this in Vercel or commit it.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-OR-SECRET-KEY
LOGIN_DOMAIN=teams.obscura.local
